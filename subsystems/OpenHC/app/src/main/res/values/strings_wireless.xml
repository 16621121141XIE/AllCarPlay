    <string name="wireless_phase_idle"></string>
    <string name="wireless_phase_preparing">正在准备</string>
    <string name="wireless_phase_scan">请用手机扫码</string>
    <string name="wireless_phase_connecting">正在连接</string>
    <string name="wireless_phase_projecting">投屏中</string>
    <string name="wireless_phase_stopping">正在断开</string>

    <!-- 阶段说明 -->
    <string name="wireless_hint_idle">点击【开始连接】按钮，使用手机扫码完成连接。</string>
    <string name="wireless_hint_preparing">正在打开蓝牙监听…</string>
    <string name="wireless_hint_scan">用华为手机扫描下面的二维码。第一次连接这台车机需要扫码配对，连接码已经包含在二维码里。</string>
    <string name="wireless_hint_bt_handshake">手机已经通过蓝牙连上，正在握手…</string>
    <string name="wireless_hint_waiting_auth">握手完成，等待手机发起认证…</string>
    <string name="wireless_hint_auth_pairing">第一次连接这台车机，正在配对…</string>
    <string name="wireless_hint_auth_trusted">正在认证（免码回连）…</string>
    <string name="wireless_hint_confirm_on_phone">手机上弹出了确认框，请在手机上点「连接」。（手机开着热点时会这样问一次）</string>
    <string name="wireless_hint_wifi_handshake">手机已经从 WiFi 连上，正在握手…</string>
    <string name="wireless_hint_device_session">正在建立设备会话…</string>
    <string name="wireless_hint_waiting_projection">设备会话已建立，等待手机开始投屏…</string>
    <string name="wireless_hint_negotiating_projection">正在协商投屏参数…</string>
    <string name="wireless_hint_stopping">正在断开连接，请稍候…</string>

    <!-- 开始不了的原因 -->
    <string name="wireless_notice_bt_address">没读到这台车机的真实蓝牙地址，二维码里的地址手机找不到车机。请到「设置 → 车机蓝牙地址」点「自动获取」，扫到这台车机点一下就填好；扫不到再手填一次。</string>
    <string name="wireless_notice_bt_unsupported">这台车机没有蓝牙，用不了无线连接。</string>
    <string name="wireless_notice_bt_off">请先打开车机蓝牙。</string>
    <string name="wireless_notice_hotspot_unsupported">这台车机是安卓 8.0 以下，没有本地热点，用不了无线连接。请插数据线连接。</string>
    <string name="wireless_notice_permissions">无线连接需要这些权限：%1$s。请点「授权」，在系统框里允许。</string>
    <string name="wireless_notice_permissions_permanent">无线连接需要这些权限：%1$s。系统不再弹框了，请点「去系统设置」，在本应用的权限里打开。</string>
    <string name="wireless_notice_precise_location">请在系统框里选「精确位置」：开热点要用精确位置权限（HmCar 不读取位置）。</string>
    <string name="wireless_notice_wired_active">有线连接正在进行。先在首页「有线连接」里点「停止」，再用无线连接。</string>
    <string name="wireless_notice_wireless_active">无线连接正在进行。先在首页「无线连接」里点「停止」，再用有线连接。</string>
    <string name="wireless_notice_ended">上次无线连接结束：%1$s</string>
    <string name="wireless_perm_bluetooth">附近的设备（蓝牙）</string>
    <string name="wireless_perm_nearby_wifi">附近的 WiFi 设备</string>
    <string name="wireless_perm_location">精确位置（开热点要用）</string>
    <string name="wireless_perm_list_separator">、</string>

    <!-- 结束原因 -->
    <string name="wireless_end_auth_closed">配对没有完成：手机断开了认证（在手机上取消了，或者二维码已经过期，请重新开始）</string>
    <string name="wireless_end_not_trusted">手机要求免码回连，但车机上没有它的配对记录。请在手机上删除这台车机，再重新扫码配对。</string>
    <string name="wireless_end_auth_failed">认证失败（%1$s）</string>
    <string name="wireless_end_step_bluetooth">蓝牙连接失败（%1$s）</string>
    <string name="wireless_end_step_auth">认证失败（%1$s）</string>
    <string name="wireless_end_step_negotiation">和手机商量 WiFi 连接失败（%1$s）</string>
    <string name="wireless_end_reconnect">自动连接手机没成（%1$s）。可以点「开始无线连接」再试。</string>
    <string name="wireless_end_reconnect_pairing">这台手机不认这台车机了，请点「开始无线连接」重新扫码配对。</string>
    <string name="wireless_end_internal">内部错误（%1$s）</string>

    <!-- 通知 -->
    <string name="wireless_notification_waiting">HmCar 无线连接</string>
    <string name="wireless_notification_scan_text">请用手机扫描车机屏幕上的二维码</string>
    <string name="wireless_notification_connecting">HmCar 正在无线连接手机</string>
